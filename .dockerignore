# Everything is excluded except what the image needs (see the Dockerfile).
*
!Dockerfile
!requirements.txt
!alembic.ini
!alembic/
!app/
!frontend/

# …and within those, nothing generated or local.
**/__pycache__
**/*.pyc
**/.DS_Store
frontend/node_modules
frontend/dist
frontend/.vite
app/**/*.orig
app/**/*.rej
