# ── Required ───────────────────────────────────────────────────────────
# Railway: add a PostgreSQL service and reference it: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ez_rankings
# A long random string — e.g. `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SECRET_KEY=
# The site's own address, e.g. https://reports.example.com
FRONTEND_URL=http://localhost:5173
APP_ENV=development

# ── First login (used once, on an empty database) ──────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Google (Search Console, Analytics, Business Profile) ───────────────
# The service-account key as raw JSON or base64.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── AI text (only used when someone presses "Write with AI") ───────────
OPENAI_API_KEY=

# ── Optional ───────────────────────────────────────────────────────────
MAX_IMAGE_MB=5
MAX_REQUEST_MB=12
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
