# ── PostgreSQL (Supabase connection string format) ──────────────────────
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Test database (local Postgres or separate Supabase project) ────────
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ez_rankings_test

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ─────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── App ────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Google Service Account ─────────────────────────────────────────────
# Set either the raw JSON string / base64 string, OR a path to the file
GOOGLE_SERVICE_ACCOUNT_JSON=

# DataForSEO Configuration
DATAFORSEO_MASTER_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
